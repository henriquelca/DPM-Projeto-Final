rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function ehGestor() {
      return logado() && perfil().tipo == "gestor";
    }
    function ehDono(uid) {
      return logado() && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read: if ehDono(uid) || ehGestor();
      allow create, update, delete: if ehGestor();
    }

    match /pontos/{id} {
      allow read: if ehDono(resource.data.usuarioId) || ehGestor();
      allow create: if ehDono(request.resource.data.usuarioId)
                    && request.resource.data.dataHora == request.time
                    && request.resource.data.tipo in ["entrada", "saida"];
      allow update, delete: if ehGestor();
    }

    match /justificativas/{id} {
      allow read: if ehDono(resource.data.usuarioId) || ehGestor();
      allow create: if ehDono(request.resource.data.usuarioId)
                    && request.resource.data.status == "pendente";
      allow update: if ehGestor()
                    || (ehDono(resource.data.usuarioId)
                        && resource.data.status == "pendente"
                        && request.resource.data.status == "pendente"
                        && request.resource.data.usuarioId == resource.data.usuarioId);
      allow delete: if ehDono(resource.data.usuarioId) && resource.data.status == "pendente";
    }
  }
}
